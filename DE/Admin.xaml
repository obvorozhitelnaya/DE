<Window x:Class="DE.Admin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DE"
        mc:Ignorable="d"
        Title="Режим администратора" Height="450" Width="800" FontFamily="Times New Roman" WindowStartupLocation="CenterScreen" Icon="/icon.ico">
    <Grid>
        <Button x:Name="backBtn" Content="Выход" HorizontalAlignment="Left" Margin="24,10,0,0" VerticalAlignment="Top" Height="34" Width="93" Background="{x:Null}" Click="backBtn_Click"/>
        <DataGrid x:Name="goodsDG" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="24,87,30,178" SelectionChanged="goodsDG_SelectionChanged">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Amount}" Value="0">
                            <Setter Property="Foreground" Value="Aqua">

                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Discount}" Value="15">
                            <Setter Property="Foreground" Value="Green">

                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>
            
        </DataGrid>
        <Image x:Name="imageB" Height="100" Width="100" Margin="20,306,680,28"/>
        <Label x:Name="categoryL" Content="" HorizontalAlignment="Left" Height="23" Margin="135,284,0,0" VerticalAlignment="Top" Width="141" FontSize="10"/>
        <Label x:Name="titleL" Content="" HorizontalAlignment="Left" Height="23" Margin="281,285,0,0" VerticalAlignment="Top" Width="394" FontSize="8"/>
        <Label Content="Действующая скидка" HorizontalAlignment="Left" Height="23" Margin="690,300,0,0" VerticalAlignment="Top" Width="100" FontSize="8"/>
        <Label x:Name="discountL" Content="" HorizontalAlignment="Left" Height="23" Margin="690,317,0,0" VerticalAlignment="Top" Width="80" FontSize="8"/>
        <Label Content="Описание товара:" HorizontalAlignment="Left" Height="22" Margin="135,306,0,0" VerticalAlignment="Top" Width="141" FontSize="8"/>
        <Label Content="Производитель:" HorizontalAlignment="Left" Height="23" Margin="135,327,0,0" VerticalAlignment="Top" Width="141" FontSize="8"/>
        <Label Content="Поставщик:" HorizontalAlignment="Left" Height="23" Margin="135,345,0,0" VerticalAlignment="Top" Width="141" FontSize="8"/>
        <Label Content="Цена:" HorizontalAlignment="Left" Height="23" Margin="135,368,0,0" VerticalAlignment="Top" Width="141" FontSize="8"/>
        <Label Content="Единица измерения:" HorizontalAlignment="Left" Height="23" Margin="135,391,0,0" VerticalAlignment="Top" Width="141" FontSize="8"/>
        <Label Content="Количество на складе:" HorizontalAlignment="Left" Height="23" Margin="135,411,0,0" VerticalAlignment="Top" Width="141" FontSize="8"/>
        <Label x:Name="descL" Content="" HorizontalAlignment="Left" Height="23" Margin="281,305,0,0" VerticalAlignment="Top" Width="141" FontSize="8"/>
        <Label x:Name="prodL" Content="" HorizontalAlignment="Left" Height="23" Margin="281,327,0,0" VerticalAlignment="Top" Width="141" FontSize="8"/>
        <Label x:Name="provL" Content="" HorizontalAlignment="Left" Height="23" Margin="281,345,0,0" VerticalAlignment="Top" Width="141" FontSize="8"/>
        <Label x:Name="costL" Content="" HorizontalAlignment="Left" Height="23" Margin="281,368,0,0" VerticalAlignment="Top" Width="141" FontSize="8"/>
        <Label x:Name="unitL" Content="" HorizontalAlignment="Left" Height="23" Margin="281,390,0,0" VerticalAlignment="Top" Width="141" FontSize="8"/>
        <Label x:Name="amountL" Content="" HorizontalAlignment="Left" Height="23" Margin="281,413,0,0" VerticalAlignment="Top" Width="141" FontSize="8"/>
        <Label x:Name="fullNameL" Content="" HorizontalAlignment="Left" Height="28" Margin="478,10,0,0" VerticalAlignment="Top" Width="292" FontSize="8"/>
        <TextBox x:Name="searchTB" HorizontalAlignment="Left" Height="33" Margin="24,49,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="227"/>
        <ComboBox x:Name="filtrCB" HorizontalAlignment="Left" Height="33" Margin="281,49,0,0" VerticalAlignment="Top" Width="222"/>
        <ComboBox x:Name="sortingCB" HorizontalAlignment="Left" Height="33" Margin="508,49,0,0" VerticalAlignment="Top" Width="222"/>
        <Button x:Name="addBtn" Content="Добавить товар" HorizontalAlignment="Left" Height="23" Margin="605,345,0,0" VerticalAlignment="Top" Width="165" Background="#FFEA4040" Click="addBtn_Click"/>
        <Button x:Name="editBtn" Content="Редактировать товар" HorizontalAlignment="Left" Height="23" Margin="605,373,0,0" VerticalAlignment="Top" Width="165" Background="#FFEA4040" Click="editBtn_Click"/>
        <Button x:Name="deleteBtn" Content="Удалить товар" HorizontalAlignment="Left" Height="22" Margin="605,402,0,0" VerticalAlignment="Top" Width="165" Background="{x:Null}" Foreground="#FFEA4040" Click="deleteBtn_Click"/>

    </Grid>
</Window>
