<Window x:Class="DE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DE"
        mc:Ignorable="d"
        Title="Авторизация" Height="450" Width="800" Icon="/icon.ico" FontFamily="Times New Roman" WindowStartupLocation="CenterScreen">
    <Grid>
        <Image Margin="564,217,32,23" Source="/icon.png" Stretch="Fill"/>
        <Button x:Name="guestBtn" Content="Войти, как гость" HorizontalAlignment="Left" Margin="657,30,0,0" VerticalAlignment="Top" Height="32" Width="111" Click="guestBtn_Click" BorderBrush="#FF707070" Background="{x:Null}"/>
        <Button x:Name="loginBtn" Content="Войти" HorizontalAlignment="Left" Margin="58,302,0,0" VerticalAlignment="Top" Height="46" Width="124" Background="#FFEE7AFC" Click="loginBtn_Click"/>
        <Label Content="Логин" HorizontalAlignment="Left" Height="31" Margin="58,70,0,0" VerticalAlignment="Top" Width="272"/>
        <Label x:Name="___Без_имени_" Content="Пароль" HorizontalAlignment="Left" Height="31" Margin="58,186,0,0" VerticalAlignment="Top" Width="258"/>
        <TextBox x:Name="loginTB" HorizontalAlignment="Left" Height="41" Margin="58,120,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="312"/>
        <PasswordBox x:Name="passTB" HorizontalAlignment="Left" Height="39" Margin="58,240,0,0" VerticalAlignment="Top" Width="328"/>

    </Grid>
</Window>
