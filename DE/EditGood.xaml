<Window x:Class="DE.EditGood"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DE"
        mc:Ignorable="d"
        Title="Изменить товар
        " Height="450" Width="800" FontFamily="Times New Roman" Icon="/icon.ico" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid>
        <Image x:Name="imageB" HorizontalAlignment="Left" Height="130" Margin="49,74,0,0" VerticalAlignment="Top" Width="168"/>
        <Button x:Name="editImageBtn" Content="Изменить фото" HorizontalAlignment="Left" Height="28" Margin="66,217,0,0" VerticalAlignment="Top" Width="143" Background="{x:Null}"/>
        <Label Content="Категория товара:" HorizontalAlignment="Left" Height="24" Margin="234,10,0,0" VerticalAlignment="Top" Width="145"/>
        <Label Content="Наименование товара:" HorizontalAlignment="Left" Height="24" Margin="234,39,0,0" VerticalAlignment="Top" Width="145"/>
        <Label Content="Артикул товара:" HorizontalAlignment="Left" Height="24" Margin="234,74,0,0" VerticalAlignment="Top" Width="145"/>
        <Label Content="Единица измерения:" HorizontalAlignment="Left" Height="24" Margin="234,103,0,0" VerticalAlignment="Top" Width="145"/>
        <Label Content="Количество на складе:" HorizontalAlignment="Left" Height="24" Margin="234,132,0,0" VerticalAlignment="Top" Width="145"/>
        <Label Content="Действующая скидка:" HorizontalAlignment="Left" Height="24" Margin="234,161,0,0" VerticalAlignment="Top" Width="145"/>
        <Label Content="Поставщик:" HorizontalAlignment="Left" Height="24" Margin="234,193,0,0" VerticalAlignment="Top" Width="145"/>
        <Label Content="Производитель:" HorizontalAlignment="Left" Height="24" Margin="234,222,0,0" VerticalAlignment="Top" Width="145"/>
        <Label Content="Цена:" HorizontalAlignment="Left" Height="24" Margin="234,251,0,0" VerticalAlignment="Top" Width="145"/>
        <Button x:Name="editGoodBtn" Content="Изменить товар" HorizontalAlignment="Left" Height="31" Margin="234,337,0,0" VerticalAlignment="Top" Width="285" Background="#FFEA4040" Click="editGoodBtn_Click"/>
        <TextBox x:Name="categoryTB" HorizontalAlignment="Left" Height="24" Margin="400,10,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="201"/>
        <TextBox x:Name="titleTB" HorizontalAlignment="Left" Height="24" Margin="400,39,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="201"/>
        <TextBox x:Name="articleTB" HorizontalAlignment="Left" Height="24" Margin="400,74,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="201"/>
        <TextBox x:Name="unitTB" HorizontalAlignment="Left" Height="24" Margin="400,103,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="201"/>
        <TextBox x:Name="amountTB" HorizontalAlignment="Left" Height="24" Margin="400,132,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="201"/>
        <TextBox x:Name="discountTB" HorizontalAlignment="Left" Height="24" Margin="400,161,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="201"/>
        <TextBox x:Name="provTB" HorizontalAlignment="Left" Height="24" Margin="400,193,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="201"/>
        <TextBox x:Name="prodTB" HorizontalAlignment="Left" Height="24" Margin="400,222,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="201"/>
        <TextBox x:Name="costTB" HorizontalAlignment="Left" Height="24" Margin="400,251,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="201"/>
        <Label Content="Описание:" HorizontalAlignment="Left" Height="24" Margin="234,280,0,0" VerticalAlignment="Top" Width="145"/>
        <TextBox x:Name="descTB" HorizontalAlignment="Left" Height="24" Margin="400,280,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="201"/>
        <Button x:Name="backBtn" Content="Выход" HorizontalAlignment="Left" Margin="24,10,0,0" VerticalAlignment="Top" Height="34" Width="93" Background="{x:Null}" Click="backBtn_Click"/>

    </Grid>
</Window>
